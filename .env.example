# Copy to .env.local (git-ignored). Values are baked in at build time and are not secrets.
# Leave CLIENT_ID or TENANT_ID empty to disable Entra; CSV/project files still work.

# App registration "Application (client) ID"
VITE_ENTRA_CLIENT_ID=
# Directory (tenant) ID or verified domain. Single tenant only: not common/organizations.
VITE_ENTRA_TENANT_ID=
# MSAL v5 redirect bridge page. Must match an SPA redirect URI on the app registration.
# Default: <origin><base>redirect.html
VITE_ENTRA_REDIRECT_URI=http://localhost:5173/redirect.html

# Optional. Comma-separated, case-insensitive regexes tested against the UPN local part and displayName.
# Empty = defaults (^svc[-_.], ^room[-_.], ^admin[-_.], no-?reply). "-" = no pattern filter.
VITE_ENTRA_EXCLUDE_PATTERNS=
# Optional. "false" keeps users that have neither employeeId nor jobTitle.
VITE_ENTRA_REQUIRE_EMPLOYEE_ID_OR_TITLE=
